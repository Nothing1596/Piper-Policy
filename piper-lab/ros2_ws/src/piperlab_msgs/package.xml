<?xml version="1.0"?>
<package format="3">
  <name>piperlab_msgs</name><version>0.1.0</version>
  <description>Piper Lab control sessions</description>
  <!-- catkin_pkg rejects reserved/non-routable domains, so the maintainer
       address must be a real routable one. -->
  <maintainer email="1493038838@qq.com">Nothing</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <depend>std_msgs</depend><depend>sensor_msgs</depend><depend>geometry_msgs</depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>
