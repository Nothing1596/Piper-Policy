<mujoco model="piper_x_scene">
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>

  <option timestep="0.002" gravity="0 0 -9.81" iterations="50" solver="Newton" cone="elliptic"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.9 0.92 0.96" rgb2="0.65 0.7 0.78" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.88 0.88 0.88" rgb2="0.78 0.78 0.78"/>
    <material name="grid_mat" texture="grid" texrepeat="4 4" reflectance="0.05"/>
    <material name="table_mat" rgba="0.75 0.78 0.82 1" specular="0.2" roughness="0.5"/>
    <material name="tray_bottom_mat" rgba="0.2 0.6 0.35 1" specular="0.1" roughness="0.6"/>
    <material name="tray_rim_mat" rgba="0.15 0.45 0.25 1" specular="0.2" roughness="0.5"/>
    <material name="cube_red_mat" rgba="0.85 0.15 0.15 1" specular="0.3" roughness="0.4"/>
    <material name="cube_blue_mat" rgba="0.15 0.3 0.85 1" specular="0.3" roughness="0.4"/>

    <material name="arm_dark" rgba="0.18 0.18 0.20 1" specular="0.4" roughness="0.4"/>
    <material name="arm_light" rgba="0.88 0.88 0.90 1" specular="0.3" roughness="0.4"/>
    <material name="arm_metal" rgba="0.7 0.7 0.72 1" specular="0.6" roughness="0.2"/>

    <mesh name="base_link" file="base_link.stl"/>
    <mesh name="link1" file="link1.stl"/>
    <mesh name="link2" file="link2.stl"/>
    <mesh name="link3" file="link3.stl"/>
    <mesh name="link4" file="link4.stl"/>
    <mesh name="link5" file="link5.stl"/>
    <mesh name="link6" file="link6.stl"/>
    <mesh name="flange" file="flange.stl"/>
    <mesh name="gripper_base" file="gripper_base.stl"/>
    <mesh name="gripper_link1" file="gripper_link1.stl"/>
    <mesh name="gripper_link2" file="gripper_link2.stl"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.05" material="grid_mat"/>

    <light directional="true" pos="0.5 -0.5 1.5" dir="-0.3 0.3 -1" diffuse="0.85 0.85 0.85" specular="0.2 0.2 0.2"/>
    <light directional="false" pos="0.3 0 1.2" diffuse="0.4 0.4 0.4"/>

    <camera name="overview_camera" pos="0.55 0.3 0.6" quat="0.324332 0.103432 0.285683 0.895821" fovy="55"/>

    <!-- Table: surface top at z = 0.0 -->
    <body name="table" pos="0.32 0.0 -0.20">
      <geom name="table_top" type="box" size="0.40 0.35 0.20" material="table_mat" friction="0.8 0.005 0.0001"/>
    </body>

    <!-- Target Tray: base centered at (0.35, 0.20, 0.003) -->
    <body name="tray" pos="0.35 0.20 0.003">
      <geom name="tray_base" type="box" size="0.07 0.07 0.003" material="tray_bottom_mat" friction="0.8 0.005 0.0001"/>
      <geom name="tray_rim_n" type="box" size="0.075 0.005 0.015" pos="0 0.075 0.012" material="tray_rim_mat"/>
      <geom name="tray_rim_s" type="box" size="0.075 0.005 0.015" pos="0 -0.075 0.012" material="tray_rim_mat"/>
      <geom name="tray_rim_e" type="box" size="0.005 0.07 0.015" pos="0.075 0 0.012" material="tray_rim_mat"/>
      <geom name="tray_rim_w" type="box" size="0.005 0.07 0.015" pos="-0.075 0 0.012" material="tray_rim_mat"/>
      <site name="tray_center" pos="0 0 0.005" size="0.01" rgba="0 1 0 0"/>
    </body>

    <!-- Rigid Cubes: side 0.030m (half-size 0.015m) -->
    <body name="cube_red" pos="0.32 -0.10 0.015">
      <freejoint name="cube_red_joint"/>
      <geom name="cube_red_geom" type="box" size="0.015 0.015 0.015" mass="0.05" material="cube_red_mat"
            friction="1.2 0.005 0.0001" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    </body>

    <body name="cube_blue" pos="0.38 -0.02 0.015">
      <freejoint name="cube_blue_joint"/>
      <geom name="cube_blue_geom" type="box" size="0.015 0.015 0.015" mass="0.05" material="cube_blue_mat"
            friction="1.2 0.005 0.0001" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    </body>

    <!-- Piper X Manipulator: base mounted at origin -->
    <body name="base_link" pos="0 0 0">
      <inertial pos="-0.004736 0.000026 0.041452" mass="1.02" fullinertia="0.00267433 0.00282612 0.00089624 -0.00000073 -0.00017389 0.0000004"/>
      <geom name="base_link_geom" type="mesh" mesh="base_link" material="arm_dark"/>

      <body name="link1" pos="0 0 0.123" quat="0 0 0 1">
        <inertial pos="0.00053 -0.00039 -0.00315" mass="0.71" fullinertia="0.00050027 0.00040879 0.00045802 0.00000078 0.00000626 0.00000462"/>
        <joint name="joint1" type="hinge" axis="0 0 1" range="-2.6179938779914944 2.6179938779914944" damping="5.0" frictionloss="0.5"/>
        <geom name="link1_geom" type="mesh" mesh="link1" material="arm_light"/>

        <body name="link2" pos="0 0 0" quat="0.7054777 0.7054777 -0.0479709 0.0479709">
          <inertial pos="0.21856 -0.00859 0.00227" mass="1.16" fullinertia="0.00111915 0.06763251 0.067559 0.00182916 0.00019233 0.00000767"/>
          <joint name="joint2" type="hinge" axis="0 0 1" range="0 3.141592653589793" damping="8.0" frictionloss="0.5"/>
          <geom name="link2_geom" type="mesh" mesh="link2" material="arm_light"/>

          <body name="link3" pos="0.28503 0 0" quat="0.1511746 0 0 0.9885071">
            <inertial pos="0.2014 -0.00418 -0.00141" mass="0.67" fullinertia="0.00033471 0.03360411 0.03356941 0.00026891 0.00013918 0.00000052"/>
            <joint name="joint3" type="hinge" axis="0 0 1" range="-2.9670597283903604 0" damping="5.0" frictionloss="0.5"/>
            <geom name="link3_geom" type="mesh" mesh="link3" material="arm_light"/>

            <body name="link4" pos="0.27364 0 0" quat="0.9991874 0 0 0.0403062">
              <inertial pos="0.059 -0.05831 0.002" mass="0.39" fullinertia="0.00120173 0.00209324 0.00307814 0.00138165 0.00001187 0.00000217"/>
              <joint name="joint4" type="hinge" axis="0 0 1" range="-1.5533430342749532 1.5533430342749532" damping="2.0" frictionloss="0.2"/>
              <geom name="link4_geom" type="mesh" mesh="link4" material="arm_light"/>

              <body name="link5" pos="0.07466 0 0" quat="0.5 -0.5 0.5 0.5">
                <inertial pos="0.00005 -0.01282 -0.00429" mass="0.35" fullinertia="0.00022660 0.00017740 0.00019425 0.00000019 0.00000005 0.00000085"/>
                <joint name="joint5" type="hinge" axis="0 0 1" range="-1.5533430342749532 1.5533430342749532" damping="2.0" frictionloss="0.2"/>
                <geom name="link5_geom" type="mesh" mesh="link5" material="arm_light"/>

                <body name="link6" pos="0 -0.03526 0" quat="0.7071068 0.7071068 0 0">
                  <inertial pos="0 0 -0.0035" mass="0.007" fullinertia="0.00152112 0.00138626 0.00031152 0.00000202 0.00000261 0.00000002"/>
                  <joint name="joint6" type="hinge" axis="0 0 1" range="-3.141592653589793 3.141592653589793" damping="1.0" frictionloss="0.1"/>
                  <geom name="link6_geom" type="mesh" mesh="link6" material="arm_dark"/>
                  <site name="flange" pos="0 0 0" quat="1 0 0 0" size="0.005" rgba="0 1 0 0.5"/>

                  <body name="flange_link" pos="0 0 0" quat="1 0 0 0">
                    <inertial pos="0.001152 0.000782 0.004798" mass="0.04" fullinertia="0.00000994 0.00001051 0.00001965 0 0 0"/>
                    <geom name="flange_geom" type="mesh" mesh="flange" material="arm_metal"/>
                    <site name="tcp" pos="0 0 0.1425" quat="1 0 0 0" size="0.005" rgba="1 0 0 0.5"/>

                    <body name="gripper_base" pos="0 0 0.0045" quat="0.7071068 0 0 0.7071068">
                      <inertial pos="-0.000184 0.000081 0.032144" mass="0.45" fullinertia="0.00092934 0.00071447 0.00039442 0.00000034 -0.00000738 0.00000005"/>
                      <geom name="gripper_base_geom" type="mesh" mesh="gripper_base" material="arm_dark"/>

                      <body name="gripper_link1" pos="0 0 0.138" quat="0.7071068 0.7071068 0 0">
                        <inertial pos="0.000651 -0.049193 0.009723" mass="0.025" fullinertia="0.00007371 0.00000781 0.00007470 -0.00000113 0.00000021 -0.00001372"/>
                        <joint name="gripper_joint1" type="slide" axis="0 0 1" range="0 0.045" damping="10.0" frictionloss="0.1"/>
                        <geom name="gripper_link1_visual" type="mesh" mesh="gripper_link1" material="arm_dark" contype="0" conaffinity="0" group="2"/>
                        <geom name="gripper_link1_geom" type="box" pos="0 -0.0125 0.003" size="0.0145 0.0125 0.003"
                              material="arm_dark" condim="4" friction="1.5 0.01 0.001" solref="0.004 1" solimp="0.95 0.99 0.001"/>
                        <geom name="gripper_link1_arm" type="box" pos="0 -0.045 0.012" size="0.020 0.018 0.008"
                              material="arm_dark" condim="4" friction="1.5 0.01 0.001" solref="0.004 1" solimp="0.95 0.99 0.001"/>
                      </body>

                      <body name="gripper_link2" pos="0 0 0.138" quat="0 0 -0.7071068 -0.7071068">
                        <inertial pos="0.000651 -0.049193 0.009723" mass="0.025" fullinertia="0.00007371 0.00000781 0.00007470 -0.00000113 0.00000021 -0.00001372"/>
                        <joint name="gripper_joint2" type="slide" axis="0 0 1" range="0 0.045" damping="10.0" frictionloss="0.1"/>
                        <geom name="gripper_link2_visual" type="mesh" mesh="gripper_link2" material="arm_dark" contype="0" conaffinity="0" group="2"/>
                        <geom name="gripper_link2_geom" type="box" pos="0 -0.0125 0.003" size="0.0145 0.0125 0.003"
                              material="arm_dark" condim="4" friction="1.5 0.01 0.001" solref="0.004 1" solimp="0.95 0.99 0.001"/>
                        <geom name="gripper_link2_arm" type="box" pos="0 -0.045 0.012" size="0.020 0.018 0.008"
                              material="arm_dark" condim="4" friction="1.5 0.01 0.001" solref="0.004 1" solimp="0.95 0.99 0.001"/>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="joint1" joint="joint1" kp="400" kv="15" forcerange="-100 100"/>
    <position name="joint2" joint="joint2" kp="800" kv="30" forcerange="-100 100"/>
    <position name="joint3" joint="joint3" kp="800" kv="30" forcerange="-100 100"/>
    <position name="joint4" joint="joint4" kp="300" kv="5" forcerange="-100 100"/>
    <position name="joint5" joint="joint5" kp="200" kv="2.5" forcerange="-100 100"/>
    <position name="joint6" joint="joint6" kp="100" kv="0.5" forcerange="-100 100"/>
    <position name="gripper_joint1" joint="gripper_joint1" kp="600" kv="10" forcerange="-30 30"/>
    <position name="gripper_joint2" joint="gripper_joint2" kp="600" kv="10" forcerange="-30 30"/>
  </actuator>

  <contact>
    <exclude body1="base_link" body2="link1"/>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link2" body2="link3"/>
    <exclude body1="link3" body2="link4"/>
    <exclude body1="link4" body2="link5"/>
    <exclude body1="link5" body2="link6"/>
    <exclude body1="link6" body2="flange_link"/>
    <exclude body1="flange_link" body2="gripper_base"/>
    <exclude body1="gripper_base" body2="gripper_link1"/>
    <exclude body1="gripper_base" body2="gripper_link2"/>
    <exclude body1="gripper_link1" body2="gripper_link2"/>
  </contact>
</mujoco>
